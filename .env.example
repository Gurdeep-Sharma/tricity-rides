# ---------------------------------------------------------------------------
# Tricity Ride — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# MongoDB connection (Prisma). Local docker-compose default shown.
# Managed hosts look like:
#   mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/tricity_ride?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/tricity_ride"

# Public site URL — used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact numbers (E.164 without spaces, e.g. +919876543210).
# Calls and WhatsApp both use the live business line.
NEXT_PUBLIC_PHONE_NUMBER=+919878649610
NEXT_PUBLIC_WHATSAPP_NUMBER=+919878649610
NEXT_PUBLIC_BUSINESS_EMAIL=booking@tricityride.com

# Lead notification email over SMTP (optional; leads persist without it).
# For Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and paste it below. A normal
# Gmail password will not authenticate. Host and port default to Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-business@gmail.com
SMTP_PASSWORD=
# Where enquiries land. Defaults to SMTP_USER when left blank.
LEAD_NOTIFICATION_EMAIL=

# Google Analytics 4 measurement ID (optional). Site works without it.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
